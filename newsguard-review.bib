	note = {Publisher: SAGE Publications Ltd},
	pages = {20539517211013861},
	file = {SAGE PDF Full Text:/Users/luhring/Zotero/storage/2WZ4CFBV/Yang et al. - 2021 - The COVID-19 Infodemic Twitter versus Facebook.pdf:application/pdf},
}

