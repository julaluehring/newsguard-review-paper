@misc{lasserSocialMediaSharing2022a,
	title = {Social media sharing by political elites: {An} asymmetric {American} exceptionalism},
	shorttitle = {Social media sharing by political elites},
	url = {http://arxiv.org/abs/2207.06313},
	doi = {10.48550/arXiv.2207.06313},
	abstract = {Increased sharing of untrustworthy information on social media platforms is one of the main challenges of our modern information society. Because information disseminated by political elites is known to shape citizen and media discourse, it is particularly important to examine the quality of information shared by politicians. Here we show that from 2016 onward, members of the Republican party in the U.S. Congress have been increasingly sharing links to untrustworthy sources. The proportion of untrustworthy information posted by Republicans versus Democrats is diverging at an accelerating rate, and this divergence has worsened since president Biden was elected. This divergence between parties seems to be unique to the U.S. as it cannot be observed in other western democracies such as Germany and the United Kingdom, where left-right disparities are smaller and have remained largely constant.},
	urldate = {2022-08-16},
	publisher = {arXiv},
	author = {Lasser, Jana and Aroyehun, Segun Taofeek and Simchon, Almog and Carrella, Fabio and Garcia, David and Lewandowsky, Stephan},
	month = jul,
	year = {2022},
	note = {arXiv:2207.06313 [cs]},
	keywords = {Computer Science - Computers and Society},
	file = {arXiv Fulltext PDF:/Users/luhring/Zotero/storage/FX2LMWK2/Lasser et al. - 2022 - Social media sharing by political elites An asymm.pdf:application/pdf;arXiv.org Snapshot:/Users/luhring/Zotero/storage/UC4D5MRF/2207.html:text/html},
}

@article{lasserAlternativeConceptionsHonesty2023,
	title = {From alternative conceptions of honesty to alternative facts in communications by {US} politicians},
	copyright = {2023 The Author(s)},
	issn = {2397-3374},
	url = {https://www.nature.com/articles/s41562-023-01691-w},
	doi = {10.1038/s41562-023-01691-w},
	abstract = {The spread of online misinformation on social media is increasingly perceived as a problem for societal cohesion and democracy. The role of political leaders in this process has attracted less research attention, even though politicians who ‘speak their mind’ are perceived by segments of the public as authentic and honest even if their statements are unsupported by evidence. By analysing communications by members of the US Congress on Twitter between 2011 and 2022, we show that politicians’ conception of honesty has undergone a distinct shift, with authentic belief speaking that may be decoupled from evidence becoming more prominent and more differentiated from explicitly evidence-based fact speaking. We show that for Republicans—but not Democrats—an increase in belief speaking of 10\% is associated with a decrease of 12.8 points of quality (NewsGuard scoring system) in the sources shared in a tweet. In contrast, an increase in fact-speaking language is associated with an increase in quality of sources for both parties. Our study is observational and cannot support causal inferences. However, our results are consistent with the hypothesis that the current dissemination of misinformation in political discourse is linked to an alternative understanding of truth and honesty that emphasizes invocation of subjective belief at the expense of reliance on evidence.},
	language = {en},
	urldate = {2023-10-02},
	journal = {Nature Human Behaviour},
	author = {Lasser, Jana and Aroyehun, Segun T. and Carrella, Fabio and Simchon, Almog and Garcia, David and Lewandowsky, Stephan},
	month = sep,
	year = {2023},
	note = {Publisher: Nature Publishing Group},
	keywords = {Politics and international relations, Language and linguistics},
	pages = {1--12},
	file = {Full Text PDF:/Users/luhring/Zotero/storage/ZC5SXWN9/Lasser et al. - 2023 - From alternative conceptions of honesty to alterna.pdf:application/pdf},
}

